# Порт HTTP/WebSocket сервера
PORT=3001

# Каталог для SQLite БД (duodone.db) та локальних фото (/uploads)
DATA_DIR=./data

# Публічний URL застосунку (для інвайт-посилань)
PUBLIC_URL=https://your-domain.example

# --- Telegram Mini App ---
# Токен бота з @BotFather (для серверної HMAC-SHA256 перевірки Telegram.WebApp.initData)
BOT_TOKEN=
# Username бота без @ (напр., duodone_bot) — формує прямі посилання t.me/<bot>?startapp=join_<CODE>
BOT_USERNAME=
# Якщо Mini App зареєстрований у @BotFather через /newapp із коротким ім'ям (t.me/<bot>/<short>?startapp=...)
TG_APP_SHORT_NAME=
# Тільки для локальної розробки без BOT_TOKEN (1 = дозволити непідписаний initData)
ALLOW_INSECURE_TG=0

# --- Object Storage (опціонально: AWS S3 / Cloudflare R2 / Supabase S3 / Backblaze B2 / MinIO) ---
# Якщо S3_BUCKET та S3_PUBLIC_URL задані — фото завантажуються в S3/R2 замість локального диска
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
